#!/usr/bin/env bash
# Runs headless nvim checks before every commit.
# Enable once per clone with:  git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

"$REPO_ROOT/scripts/smoke-test.sh"

nvim --headless \
  -c "Lazy load plenary.nvim" \
  -c "PlenaryBustedDirectory tests/ {sequential = true}" \
  -c "qa!"
